
pipeline {
    agent any

    stages {
        stage('Build') {
            agent {
                docker {
                    image 'python:3.9-slim'
                    reuseNode true
                }
            }
            steps {
                sh 'pip install Django==3.2'
                sh 'python3 manage.py check'
                echo 'Django checks passed successfully.'
            }
        }

        stage('Deploy') {
            steps {
                // Build the image
                sh 'docker build -t todo invalid-directory'

                // Run the container
                sh 'docker run -d -p 8000:8000 --name todo_container todo'
            }

            post {
                always {
                    echo 'Waiting for 2 minutes before cleanup...'
                    sleep 120

                    echo 'Stopping container...'
                    sh 'docker stop todo_container || true'

                    echo 'Removing container...'
                    sh 'docker rm todo_container || true'
                }
            }
        }
    }

    // Task 1: Pipeline Failure Handling
    post {
        success {
            echo 'Pipeline executed successfully'
        }

        failure {
            echo 'Pipeline execution failed'
        }

        always {
            echo 'Pipeline execution completed'
        }
    }
}
